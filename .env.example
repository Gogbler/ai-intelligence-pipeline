# FrontierAtlas AI Intelligence Pipeline Environment Configuration

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
# Default standalone SQLite DB (ready out-of-the-box):
DATABASE_URL=sqlite:///C:/Users/royal/.gemini/antigravity/scratch/ai-intelligence-pipeline/data/intelligence_graph.db
# Or PostgreSQL for production / Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/frontieratlas

# Redis (for distributed locks, bloom filters, and job queues)
REDIS_URL=redis://localhost:6379/0

# Multi-Tier LLM Orchestration API Keys
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# GitHub API Token (Optional, elevates rate limit from 60 to 5,000 requests/hr)
GITHUB_TOKEN=

# Crawler & Concurrency Settings
CRAWLER_CONCURRENCY=10
REQUEST_TIMEOUT=15
MAX_RETRIES=3
BACKOFF_FACTOR=1.5

# Exports Directory
DATA_EXPORT_DIR=C:/Users/royal/.gemini/antigravity/scratch/ai-intelligence-pipeline/data/exports
